# 로컬 실행 또는 Railway 배포에 필요한 값입니다.
# 실제 비밀번호/시크릿은 .env 또는 Railway Variables에만 넣고 Git에는 올리지 않습니다.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
NEXTAUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# npm run admin:create 실행 시 사용할 관리자 계정입니다.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME_TO_A_STRONG_PASSWORD"

# 순위 스냅샷 배치 엔드포인트(/api/cron/rank-snapshot) 인증 키. 없으면 해당 엔드포인트는 503으로 꺼집니다.
# CRON_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# 무통장입금 계좌 — 세 값을 모두 넣어야 회원 충전 화면에 적용됩니다.
# 넣지 않으면 코드에 적혀 있던 기본 값이 표시되고, 관리자 대시보드에 확인 경고가 뜹니다.
# DEPOSIT_BANK="은행명"
# DEPOSIT_ACCOUNT="000000-00-000000"
# DEPOSIT_HOLDER="예금주"

# (선택) 키워드 트렌드 — 네이버 데이터랩 검색어 트렌드 연동 키.
# NAVER API HUB(네이버 클라우드)에서 '검색어 트렌드' API 키를 발급받아 넣습니다.
# 없으면 키워드 트렌드 화면에 '연동 준비 중' 안내와 네이버 공식 도구 링크가 표시됩니다.
# NAVER_API_HUB_KEY_ID="YOUR_KEY_ID"
# NAVER_API_HUB_KEY="YOUR_KEY"
# 기존 네이버 개발자센터 키(데이터랩 사용 설정된 앱)가 있다면 2027-06-30까지는 아래 값으로도 동작합니다.
# NAVER_CLIENT_ID="YOUR_CLIENT_ID"
# NAVER_CLIENT_SECRET="YOUR_CLIENT_SECRET"

# (선택) 플레이스 분석 — 네이버 플레이스 공개 화면의 데이터를 실제로 조회하는 기능입니다(공식 API 아님).
# 끄려면 PLACE_LOOKUP="off". 하루에 네이버로 보내는 요청 수 상한은 PLACE_LOOKUP_DAILY_MAX (기본 3000).
# PLACE_LOOKUP="off"
# PLACE_LOOKUP_DAILY_MAX="3000"
