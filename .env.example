# 로컬 실행 또는 Railway 배포에 필요한 값입니다.
# 실제 비밀번호/시크릿은 .env 또는 Railway Variables에만 넣고 Git에는 올리지 않습니다.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
NEXTAUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# npm run admin:create 실행 시 사용할 관리자 계정입니다.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME_TO_A_STRONG_PASSWORD"

# (선택) 네이버 오픈API — https://developers.naver.com 에서 애플리케이션 등록 후 발급.
# 등록하면 키워드 분석/쇼핑 순위추적이 네이버 실데이터로 동작합니다.
# 없으면 결정론적 추정 데이터로 자동 폴백되며, UI에 '추정 데이터' 뱃지가 표시됩니다.
# NAVER_CLIENT_ID="YOUR_CLIENT_ID"
# NAVER_CLIENT_SECRET="YOUR_CLIENT_SECRET"
